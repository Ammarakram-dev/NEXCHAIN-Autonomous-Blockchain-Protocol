PRODUCER_VERSION = 1

DEFAULT_BLOCK_REWARD = 10.0
DEFAULT_BLOCK_MAX_TRANSACTIONS = 1000
DEFAULT_BLOCK_MAX_BYTES = 2_000_000


class BlockProductionError(Exception):
    pass


class BlockAssemblyError(BlockProductionError):
    pass


class BlockValidationError(BlockProductionError):
    pass


class RewardError(BlockProductionError):
    pass


@dataclass(frozen=True)
class ProductionResult:
    success: bool
    block: Optional[Block]
    state_root: str
    transaction_count: int
    total_fees: float
    block_reward: float
    producer_reward: float
    message: str
    production_time: float

    def to_dict(self) -> dict[str, Any]:
        return {
            "success": self.success,
            "block": self.block.to_dict() if self.block else None,
            "state_root": self.state_root,
            "transaction_count": self.transaction_count,
            "total_fees": self.total_fees,
            "block_reward": self.block_reward,
            "producer_reward": self.producer_reward,
            "message": self.message,
            "production_time": self.production_time,
        }


@dataclass
class ProductionMetrics:
    blocks_produced: int = 0
    blocks_failed: int = 0
    transactions_selected: int = 0
    total_fees_processed: float = 0.0
    total_rewards_processed: float = 0.0
    total_production_time: float = 0.0

    @property
    def average_production_time(self) -> float:
        if self.blocks_produced == 0:
            return 0.0

        return (
            self.total_production_time
            / self.blocks_produced
        )

    def to_dict(self) -> dict[str, Any]:
        return {
            "blocks_produced": self.blocks_produced,
            "blocks_failed": self.blocks_failed,
            "transactions_selected": self.transactions_selected,
            "total_fees_processed": self.total_fees_processed,
            "total_rewards_processed": self.total_rewards_processed,
            "total_production_time": self.total_production_time,
            "average_production_time": self.average_production_time,
        }


class BlockProducer:

    def __init__(
        self,
        state: StateEngine,
        mempool: Mempool,
        consensus: Optional[ConsensusEngine] = None,
        block_reward: float = DEFAULT_BLOCK_REWARD,
        max_transactions: int = DEFAULT_BLOCK_MAX_TRANSACTIONS,
        max_block_bytes: int = DEFAULT_BLOCK_MAX_BYTES,
    ) -> None:

        if not isinstance(state, StateEngine):
            raise TypeError(
                "state must be a StateEngine instance."
            )

        if not isinstance(mempool, Mempool):
            raise TypeError(
                "mempool must be a Mempool instance."
            )

        if consensus is not None and not isinstance(
            consensus,
            ConsensusEngine,
        ):
            raise TypeError(
                "consensus must be a ConsensusEngine instance or None."
            )

        if block_reward < 0:
            raise ValueError(
                "Block reward cannot be negative."
            )

        if max_transactions <= 0:
            raise ValueError(
                "max_transactions must be positive."
            )

        if max_block_bytes <= 0:
            raise ValueError(
                "max_block_bytes must be positive."
            )

        self.state = state
        self.mempool = mempool
        self.consensus = consensus
        self.block_reward = float(block_reward)
        self.max_transactions = int(max_transactions)
        self.max_block_bytes = int(max_block_bytes)
        self.metrics = ProductionMetrics()

    # ========================================================
    # HELPERS
    # ========================================================

    @staticmethod
    def _canonical_json(value: Any) -> str:
        return json.dumps(
            value,
            sort_keys=True,
            separators=(",", ":"),
            ensure_ascii=False,
        )

    @staticmethod
    def _safe_float(value: Any) -> float:
        result = float(value)

        if result != result:
            raise ValueError(
                "NaN value is not allowed."
            )

        if result in (
            float("inf"),
            float("-inf"),
        ):
            raise ValueError(
                "Infinite value is not allowed."
            )

        return result

    # ========================================================
    # 17A — BLOCK PRODUCTION ENGINE
    # ========================================================

    def next_height(
        self,
        blockchain: Any,
    ) -> int:

        if blockchain is None:
            raise ValueError(
                "blockchain is required."
            )

        return int(blockchain.height) + 1

    def previous_hash(
        self,
        blockchain: Any,
    ) -> str:

        if blockchain is None:
            raise ValueError(
                "blockchain is required."
            )

        block = blockchain.latest_block

        if not block.block_hash:
            raise BlockProductionError(
                "Latest block has no hash."
            )

        return block.block_hash

    # ========================================================
    # 17B — MEMPOOL → BLOCK ASSEMBLY
    # ========================================================

    def select_transactions(
        self,
        blockchain: Any,
        max_transactions: Optional[int] = None,
        max_bytes: Optional[int] = None,
    ) -> list[Transaction]:

        transaction_limit = (
            self.max_transactions
            if max_transactions is None
            else int(max_transactions)
        )

        byte_limit = (
            self.max_block_bytes
            if max_bytes is None
            else int(max_bytes)
        )

        if transaction_limit <= 0:
            raise BlockAssemblyError(
                "Transaction limit must be positive."
            )

        if byte_limit <= 0:
            raise BlockAssemblyError(
                "Block byte limit must be positive."
            )

        # Existing Step 16 API:
        # select_for_block(max_transactions)
        selected = self.mempool.select_for_block(
            transaction_limit
        )

        if selected is None:
            return []

        selected = list(selected)

        accepted: list[Transaction] = []
        current_size = 0

        for transaction in selected:

            transaction_size = len(
                self._canonical_json(
                    transaction.to_dict()
                ).encode("utf-8")
            )

            if (
                current_size
                + transaction_size
                > byte_limit
            ):
                break

            accepted.append(transaction)
            current_size += transaction_size

            if (
                len(accepted)
                >= transaction_limit
            ):
                break

        return accepted

    def calculate_total_fees(
        self,
        transactions: list[Transaction],
    ) -> float:

        total = 0.0

        for transaction in transactions:
            total += self._safe_float(
                transaction.fee
            )

        return total

    def estimate_block_size(
        self,
        transactions: list[Transaction],
    ) -> int:

        payload = [
            transaction.to_dict()
            for transaction in transactions
        ]

        return len(
            self._canonical_json(
                payload
            ).encode("utf-8")
        )

    # ========================================================
    # INTERNAL EXECUTION BLOCK
    # ========================================================

    def _create_execution_block(
        self,
        transactions: list[Transaction],
        validator: str,
        height: int,
        previous_hash: str,
        difficulty: int = 0,
    ) -> Block:
        """
        Create a temporary Block suitable for
        StateBlockExecutor.execute_block().

        The existing StateBlockExecutor API accepts
        a Block object, not a transaction list.
        """

        block = create_block(
            height=int(height),
            previous_hash=previous_hash,
            validator=validator,
            transactions=list(transactions),
            difficulty=int(difficulty),
        )

        return block

    # ========================================================
    # 17C — STATE TRANSITION
    # ========================================================

    def preview_state_transition(
        self,
        transactions: list[Transaction],
    ) -> tuple[StateEngine, str]:

        """
        Preview transaction execution without permanently
        modifying the live state.

        StateBlockExecutor.execute_block() requires a Block.
        Therefore a temporary execution block is constructed.
        """

        executor = StateBlockExecutor(
            self.state
        )

        snapshot = self.state.snapshot()

        try:

            # Temporary block used only for state execution.
            #
            # StateBlockExecutor requires a Block and reads
            # block.block_hash / block.transactions.
            execution_block = (
                self._create_execution_block(
                    transactions=transactions,
                    validator="NEX" + ("0" * 40),
                    height=0,
                    previous_hash="0" * 64,
                    difficulty=0,
                )
            )

            executor.execute_block(
                execution_block
            )

            root = self.state.state_root()

            return self.state, root

        finally:

            self.state.restore(
                snapshot
            )

    def commit_state_transition(
        self,
        block: Block,
    ) -> str:

        """
        Commit the transactions contained in a real Block.

        StateBlockExecutor.execute_block() receives the
        complete Block object.
        """

        if not isinstance(
            block,
            Block,
        ):
            raise TypeError(
                "block must be a Block instance."
            )

        executor = StateBlockExecutor(
            self.state
        )

        executor.execute_block(
            block
        )

        return self.state.state_root()

    # ========================================================
    # 17D — MERKLE + STATE ROOT
    # ========================================================

    def calculate_merkle_root(
        self,
        transactions: list[Transaction],
    ) -> str:

        if not transactions:
            return "0" * 64

        hashes = [
            transaction.transaction_hash()
            for transaction in transactions
        ]

        while len(hashes) > 1:

            if len(hashes) % 2 == 1:
                hashes.append(
                    hashes[-1]
                )

            next_level: list[str] = []

            for index in range(
                0,
                len(hashes),
                2,
            ):

                left = hashes[index]
                right = hashes[index + 1]

                combined = (
                    bytes.fromhex(left)
                    + bytes.fromhex(right)
                )

                parent = hashlib.sha256(
                    hashlib.sha256(
                        combined
                    ).digest()
                ).hexdigest()

                next_level.append(
                    parent
                )

            hashes = next_level

        return hashes[0]

    def finalize_block_roots(
        self,
        block: Block,
        state_root: str,
    ) -> Block:

        block.merkle_root = (
            self.calculate_merkle_root(
                block.transactions
            )
        )

        block.state_root = state_root
        block.block_hash = ""

        block.finalize()

        return block

    # ========================================================
    # 17E — CONSENSUS VALIDATOR
    # ========================================================

    def validate_validator(
        self,
        validator: str,
    ) -> tuple[bool, str]:

        if not isinstance(
            validator,
            str,
        ):
            return (
                False,
                "Validator must be a string.",
            )

        if not validator.startswith("NEX"):
            return (
                False,
                "Invalid validator prefix.",
            )

        if len(validator) != 43:
            return (
                False,
                "Invalid validator length.",
            )

        if self.consensus is None:
            return (
                True,
                "Consensus validation skipped.",
            )

        validators = getattr(
            self.consensus,
            "validators",
            None,
        )

        if validators is None:
            return (
                True,
                "Validator registry unavailable.",
            )

        if validator not in validators:
            return (
                False,
                "Validator is not registered.",
            )

        record = validators[validator]

        if not getattr(
            record,
            "active",
            True,
        ):
            return (
                False,
                "Validator is inactive.",
            )

        return (
            True,
            "Validator is valid.",
        )

    # ========================================================
    # 17F — FULL BLOCK VALIDATION
    # ========================================================

    def validate_candidate(
        self,
        block: Block,
        blockchain: Any,
        expected_state_root: Optional[str] = None,
    ) -> tuple[bool, str]:

        if block is None:
            return (
                False,
                "Candidate block is missing.",
            )

        if blockchain is None:
            return (
                False,
                "Blockchain is missing.",
            )

        expected_height = (
            int(blockchain.height) + 1
        )

        if block.height != expected_height:
            return (
                False,
                f"Invalid block height. "
                f"Expected {expected_height}.",
            )

        if (
            block.previous_hash
            != blockchain.latest_block.block_hash
        ):
            return (
                False,
                "Previous hash mismatch.",
            )

        valid_validator, validator_reason = (
            self.validate_validator(
                block.validator
            )
        )

        if not valid_validator:
            return (
                False,
                validator_reason,
            )

        expected_merkle = (
            self.calculate_merkle_root(
                block.transactions
            )
        )

        if block.merkle_root != expected_merkle:
            return (
                False,
                "Merkle root mismatch.",
            )

        if expected_state_root is not None:
            if (
                block.state_root
                != expected_state_root
            ):
                return (
                    False,
                    "State root mismatch.",
                )

        calculated_hash = (
            block.calculate_hash()
        )

        if block.block_hash != calculated_hash:
            return (
                False,
                "Block hash mismatch.",
            )

        valid, reason = block.validate(
            expected_previous_hash=(
                blockchain.latest_block.block_hash
            )
        )

        if not valid:
            return (
                False,
                reason,
            )

        for transaction in block.transactions:

            result = transaction.validate()

            if isinstance(
                result,
                tuple,
            ):

                valid_tx, tx_reason = result

                if not valid_tx:
                    return (
                        False,
                        f"Invalid transaction: "
                        f"{tx_reason}",
                    )

            elif result is False:

                return (
                    False,
                    "Invalid transaction.",
                )

        return (
            True,
            "Candidate block is valid.",
        )

    # ========================================================
    # 17G — REWARD + FEES
    # ========================================================

    def calculate_reward(
        self,
        transactions: list[Transaction],
    ) -> tuple[float, float]:

        total_fees = (
            self.calculate_total_fees(
                transactions
            )
        )

        producer_reward = (
            self.block_reward
            + total_fees
        )

        return (
            total_fees,
            producer_reward,
        )

    def apply_block_reward(
        self,
        validator: str,
    ) -> None:

        if self.block_reward <= 0:
            return

        account = self.state.get_account(
            validator
        )

        if account is None:
            self.state.create_account(
                validator,
                balance=0.0,
                nonce=0,
            )

        self.state.credit(
            validator,
            self.block_reward,
        )

    # ========================================================
    # BLOCK ASSEMBLY
    # ========================================================

    def assemble_block(
        self,
        blockchain: Any,
        validator: str,
        transactions: list[Transaction],
        difficulty: int = 0,
    ) -> Block:

        valid_validator, reason = (
            self.validate_validator(
                validator
            )
        )

        if not valid_validator:
            raise BlockAssemblyError(
                reason
            )

        if len(transactions) > (
            self.max_transactions
        ):
            raise BlockAssemblyError(
                "Transaction count exceeds block limit."
            )

        size = self.estimate_block_size(
            transactions
        )

        if size > self.max_block_bytes:
            raise BlockAssemblyError(
                "Block exceeds byte limit."
            )

        return create_block(
            height=(
                int(blockchain.height) + 1
            ),
            previous_hash=(
                blockchain.latest_block.block_hash
            ),
            validator=validator,
            transactions=transactions,
            difficulty=int(difficulty),
        )

    # ========================================================
    # COMPLETE PRODUCTION PIPELINE
    # ========================================================

    def produce_block(
        self,
        blockchain: Any,
        validator: str,
        difficulty: int = 0,
        max_transactions: Optional[int] = None,
        max_bytes: Optional[int] = None,
    ) -> ProductionResult:

        started = time.perf_counter()

        try:

            if blockchain is None:
                raise BlockProductionError(
                    "Blockchain is required."
                )

            # 1 — Validator
            valid_validator, reason = (
                self.validate_validator(
                    validator
                )
            )

            if not valid_validator:
                raise BlockProductionError(
                    reason
                )

            # 2 — Select transactions
            transactions = (
                self.select_transactions(
                    blockchain=blockchain,
                    max_transactions=max_transactions,
                    max_bytes=max_bytes,
                )
            )

            # 3 — Calculate fees
            total_fees, producer_reward = (
                self.calculate_reward(
                    transactions
                )
            )

            # 4 — Preview transaction state
            _, transaction_state_root = (
                self.preview_state_transition(
                    transactions
                )
            )

            # 5 — Assemble block
            block = self.assemble_block(
                blockchain=blockchain,
                validator=validator,
                transactions=transactions,
                difficulty=difficulty,
            )

            # 6 — Finalize candidate
            self.finalize_block_roots(
                block,
                transaction_state_root,
            )

            # 7 — Validate candidate
            valid, reason = (
                self.validate_candidate(
                    block=block,
                    blockchain=blockchain,
                    expected_state_root=(
                        transaction_state_root
                    ),
                )
            )

            if not valid:
                raise BlockValidationError(
                    reason
                )

            # 8 — Commit transaction state
            committed_root = (
                self.commit_state_transition(
                    block
                )
            )

            if (
                committed_root
                != transaction_state_root
            ):
                raise BlockProductionError(
                    "Committed state root differs "
                    "from preview state root."
                )

            # 9 — Apply base block reward
            #
            # Transaction fees have already been
            # deducted from senders by StateEngine.
            # Only the block reward is newly minted.
            self.apply_block_reward(
                validator
            )

            final_state_root = (
                self.state.state_root()
            )

            # 10 — Finalize final state root
            self.finalize_block_roots(
                block,
                final_state_root,
            )

            # 11 — Final validation
            valid, reason = (
                self.validate_candidate(
                    block=block,
                    blockchain=blockchain,
                    expected_state_root=(
                        final_state_root
                    ),
                )
            )

            if not valid:
                raise BlockValidationError(
                    reason
                )

            # 12 — Remove confirmed transactions
            if transactions:

                hashes = [
                    transaction.transaction_hash()
                    for transaction in transactions
                ]

                self.mempool.remove_confirmed(
                    hashes
                )

            elapsed = (
                time.perf_counter()
                - started
            )

            self.metrics.blocks_produced += 1
            self.metrics.transactions_selected += (
                len(transactions)
            )
            self.metrics.total_fees_processed += (
                total_fees
            )
            self.metrics.total_rewards_processed += (
                self.block_reward
            )
            self.metrics.total_production_time += (
                elapsed
            )

            return ProductionResult(
                success=True,
                block=block,
                state_root=final_state_root,
                transaction_count=len(
                    transactions
                ),
                total_fees=total_fees,
                block_reward=self.block_reward,
                producer_reward=producer_reward,
                message=(
                    "Block produced successfully."
                ),
                production_time=elapsed,
            )

        except Exception as exc:

            elapsed = (
                time.perf_counter()
                - started
            )

            self.metrics.blocks_failed += 1

            return ProductionResult(
                success=False,
                block=None,
                state_root="",
                transaction_count=0,
                total_fees=0.0,
                block_reward=self.block_reward,
                producer_reward=0.0,
                message=str(exc),
                production_time=elapsed,
            )

    # ========================================================
    # STATS
    # ========================================================

    def stats(self) -> dict[str, Any]:

        return {
            "producer_version": PRODUCER_VERSION,
            "block_reward": self.block_reward,
            "max_transactions": self.max_transactions,
            "max_block_bytes": self.max_block_bytes,
            "metrics": self.metrics.to_dict(),
            "state_root": self.state.state_root(),
            "state_supply": self.state.total_supply,
        }


