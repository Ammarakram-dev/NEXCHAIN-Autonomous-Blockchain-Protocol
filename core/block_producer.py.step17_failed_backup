def self_test() -> None:

    print("=" * 70)
    print(
        "NEXCHAIN BLOCK PRODUCTION ENGINE — STEP 17 TEST"
    )
    print("=" * 70)

    from crypto.crypto_engine import Wallet
    from core.blockchain import Blockchain
    from core.transaction import create_transaction

    validator_wallet = Wallet.generate()
    sender_wallet = Wallet.generate()
    receiver_wallet = Wallet.generate()

    validator = validator_wallet.address()
    sender = sender_wallet.address()
    receiver = receiver_wallet.address()

    # ========================================================
    # INITIAL STATE
    # ========================================================

    state = StateEngine()

    state.create_account(
        sender,
        balance=1000.0,
        nonce=0,
    )

    state.create_account(
        receiver,
        balance=100.0,
        nonce=0,
    )

    state.create_account(
        validator,
        balance=0.0,
        nonce=0,
    )

    blockchain = Blockchain(
        genesis_validator=validator
    )

    mempool = Mempool()

    producer = BlockProducer(
        state=state,
        mempool=mempool,
        consensus=None,
        block_reward=10.0,
        max_transactions=100,
        max_block_bytes=1_000_000,
    )

    print(
        "[PASS] 17A Block producer initialization"
    )

    # ========================================================
    # 17B — TRANSACTION
    # ========================================================

    transaction = create_transaction(
        wallet=sender_wallet,
        recipient=receiver,
        amount=250.0,
        fee=1.0,
        nonce = 0,
    )

    added = mempool.add(
        transaction
    )

    if isinstance(
        added,
        tuple,
    ):
        added_ok = bool(
            added[0]
        )

        added_reason = (
            str(added[1])
            if len(added) > 1
            else ""
        )

    else:

        added_ok = bool(
            added
        )

        added_reason = ""

    assert added_ok, added_reason

    print(
        "[PASS] 17B Mempool → block assembly"
    )

    # ========================================================
    # 17B — SELECTION
    # ========================================================

    selected = (
        producer.select_transactions(
            blockchain=blockchain,
            max_transactions=100,
            max_bytes=1_000_000,
        )
    )

    assert len(selected) == 1

    fees = (
        producer.calculate_total_fees(
            selected
        )
    )

    assert abs(
        fees - 1.0
    ) < 1e-9

    print(
        "[PASS] 17B Transaction selection + fees"
    )

    # ========================================================
    # 17C — PREVIEW
    # ========================================================

    _, preview_root = (
        producer.preview_state_transition(
            selected
        )
    )

    assert isinstance(
        preview_root,
        str,
    )

    assert len(
        preview_root
    ) == 64

    print(
        "[PASS] 17C State transition preview"
    )

    # ========================================================
    # 17D — MERKLE
    # ========================================================

    merkle = (
        producer.calculate_merkle_root(
            selected
        )
    )

    assert len(
        merkle
    ) == 64

    print(
        "[PASS] 17D Merkle root generation"
    )

    # ========================================================
    # 17D — BLOCK
    # ========================================================

    block = (
        producer.assemble_block(
            blockchain=blockchain,
            validator=validator,
            transactions=selected,
            difficulty=0,
        )
    )

    producer.finalize_block_roots(
        block,
        preview_root,
    )

    assert block.height == 1

    assert (
        block.state_root
        == preview_root
    )

    assert (
        block.merkle_root
        == merkle
    )

    assert len(
        block.block_hash
    ) == 64

    print(
        "[PASS] 17D State root + block hash finalization"
    )

    # ========================================================
    # 17F — VALIDATION
    # ========================================================

    valid, reason = (
        producer.validate_candidate(
            block=block,
            blockchain=blockchain,
            expected_state_root=preview_root,
        )
    )

    assert valid, reason

    print(
        "[PASS] 17F Full candidate validation"
    )

    # ========================================================
    # 17G — REWARD
    # ========================================================

    total_fees, producer_reward = (
        producer.calculate_reward(
            selected
        )
    )

    assert abs(
        total_fees - 1.0
